<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

  <!--
    Bukkit hands out live objects (Player, Location, ItemStack) that are meant to be stored
    and passed around by reference; SpotBugs flags that as exposing internal representation.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    Records generated by javac trip the "may expose" checks on their accessors as well.
  -->
  <Match>
    <Source name="~.*Settings\.java"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    Reflection into Essentials is intentional and every failure path is handled; SpotBugs
    cannot see that the methods were validated at startup.
  -->
  <Match>
    <Class name="dev.banhammer.plugin.integration.EssentialsJailIntegration"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!--
    Switch statements over PunishmentType deliberately omit a default where every constant is
    listed; adding a new constant should then fail compilation rather than fall through.
  -->
  <Match>
    <Bug pattern="SF_SWITCH_NO_DEFAULT"/>
  </Match>

</FindBugsFilter>
